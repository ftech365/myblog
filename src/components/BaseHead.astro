---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  image?: string;
}
const SITE_TITLE = 'FTechNotes';
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(rawPath, Astro.site);
const { title, description, image = '/og-default.png' } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!-- Global Metadata -->
<meta charset="utf-8" />
<!-- Content Security Policy（GitHub Pages はレスポンスヘッダーを設定できないため meta で指定） -->
<meta
  http-equiv="Content-Security-Policy"
  content={[
    "default-src 'self'",
    "script-src 'self' https://www.googletagmanager.com",
    "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com",
    "img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com",
    // Google Fonts（global.css の @import）を読み込むため
    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
    "font-src 'self' https://fonts.gstatic.com",
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'self'",
  ].join('; ')}
/>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(`${base}/rss.xml`, Astro.site)} />
<meta name="generator" content={Astro.generator} />
<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<!-- Google Search Console -->
<meta name="google-site-verification" content="bjiDkdSbkK5lVuIKLhFYkmGbxoxop6bfDISk7b_Ytcc" />
<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VMKBRKM2PN"></script>
<script is:inline src={`${base}/gtag-init.js`}></script>
